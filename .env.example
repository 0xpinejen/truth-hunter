# Copy to .env; launch scripts load this file. Never commit credentials.
TENCENTCLOUD_WSA_APIKEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Explicit permitted public domains for the read-only browser, comma separated.
BROWSER_ALLOWED_DOMAINS=cloud.tencent.com
# Use doh only when local DNS returns proxy fake-IP addresses. TLS remains verified.
BROWSER_DNS_MODE=system
DATABASE_URL=sqlite:///./data/truthhunter.db
ARTIFACT_DIR=./artifacts
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# EdgeOne server-only production environment (never NEXT_PUBLIC_).
# SCF reserves TENCENTCLOUD_ names, so deploy this alias instead.
YUANBAO_API_KEY=
TH_SESSION_SECRET=
TH_PUBLIC_ORIGIN=
# Allow arbitrary public HTTPS sources, with per-hop public-IP/TLS validation.
BROWSER_ALLOW_PUBLIC_WEB=false
