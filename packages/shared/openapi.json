  "components": {
    "schemas": {
      "ClaimReview": {
        "properties": {
          "claim_id": {
            "type": "string",
            "title": "Claim Id"
          },
          "method": {
            "type": "string",
            "enum": [
              "independent_sources",
              "primary_document",
              "insufficient"
            ],
            "title": "Method"
          },
          "documentary_scope": {
            "type": "string",
            "maxLength": 2000,
            "title": "Documentary Scope",
            "default": ""
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 20,
            "title": "Rationale"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "claim_id",
          "method",
          "rationale"
        ],
        "title": "ClaimReview"
      },
      "CreateInvestigation": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Message"
          },
          "mode": {
            "type": "string",
            "enum": [
              "quick",
              "deep"
            ],
            "title": "Mode",
            "default": "quick"
          },
          "data_mode": {
            "type": "string",
            "enum": [
              "live",
              "fixture"
            ],
            "title": "Data Mode",
            "default": "live"
          },
          "workflow": {
            "type": "string",
            "enum": [
              "investigation",
              "search"
            ],
            "title": "Workflow",
            "default": "investigation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "CreateInvestigation"
      },
      "EvidenceReview": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          },
          "stance": {
            "type": "string",
            "enum": [
              "supports",
              "refutes",
              "context"
            ],
            "title": "Stance"
          },
          "relevant": {
            "type": "boolean",
            "title": "Relevant"
          },
          "time_matches": {
            "type": "boolean",
            "title": "Time Matches"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 10,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "stance",
          "relevant",
          "time_matches",
          "reason"
        ],
        "title": "EvidenceReview"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageInput": {
        "properties": {
          "data_url": {
            "type": "string",
            "maxLength": 7000000,
            "title": "Data Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data_url"
        ],
        "title": "ImageInput"
      },
      "ReviewSubmission": {
        "properties": {
          "report_id": {
            "type": "string",
            "title": "Report Id"
          },
          "reviewer": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Reviewer"
          },
          "review_type": {
            "type": "string",
            "enum": [
              "manual",
              "assistant"
            ],
            "title": "Review Type"
          },
          "acknowledged": {
            "type": "boolean",
            "title": "Acknowledged"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceReview"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Sources"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceReview"
            },
            "type": "array",
            "maxItems": 48,
            "title": "Evidence"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/ClaimReview"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Claims"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "report_id",
          "reviewer",
          "review_type",
          "acknowledged",
          "claims"
        ],
        "title": "ReviewSubmission"
      },
      "SourceReview": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "origin_group": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Origin Group"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "original_reporting",
              "attributed",
              "unknown"
            ],
            "title": "Role"
          },
          "independence_confirmed": {
            "type": "boolean",
            "title": "Independence Confirmed",
            "default": false
          },
          "basis_quote": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 10,
            "title": "Basis Quote"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 20,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "origin_group",
          "role",
          "basis_quote",
          "reason"
        ],
        "title": "SourceReview"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
